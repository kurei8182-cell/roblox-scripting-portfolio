  <Item class="StarterPlayer" referent="21">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">40</float>
      <float name="CameraMinZoomDistance">6</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="22">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Settings = require(Shared.Settings)

local Effects = {}
local tracks = setmetatable({}, { __mode = "k" })

local function animation(model, kind, combo)
	local id = Settings.Animations[kind]
	if type(id) == "table" then id = id[combo] end
	if type(id) ~= "number" or id <= 0 then return end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then return end
	local cache = tracks[model]
	if not cache then cache = {} tracks[model] = cache end
	if not cache[id] then
		local asset = Instance.new("Animation")
		asset.AnimationId = "rbxassetid://" .. id
		local ok, track = pcall(function() return animator:LoadAnimation(asset) end)
		asset:Destroy()
		if not ok then return end
		track.Priority = Enum.AnimationPriority.Action
		cache[id] = track
	end
	cache[id]:Play(0.05)
end

function Effects.play(payload)
	local model = payload.model
	if typeof(model) ~= "Instance" or not model:IsA("Model") or not model.Parent then return end
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local kind = payload.kind
	local combo = if type(payload.extra) == "table" then payload.extra.combo else 1
	animation(model, kind, combo)
	local colors = {
		Light = Color3.fromRGB(255, 183, 115), Heavy = Color3.fromRGB(255, 104, 83),
		Hit = Color3.fromRGB(255, 94, 109), Parry = Color3.fromRGB(106, 188, 255),
		ParrySuccess = Color3.fromRGB(118, 255, 224), Parried = Color3.fromRGB(255, 220, 112),
		Dash = Color3.fromRGB(167, 225, 255),
	}
	local highlight = Instance.new("Highlight")
	highlight.Adornee, highlight.FillColor = model, colors[kind] or Color3.new(1, 1, 1)
	highlight.OutlineTransparency, highlight.FillTransparency = 1, 0.35
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	local duration = if type(payload.extra) == "table" then math.max(0.2, payload.extra.windup or 0) else 0.25
	TweenService:Create(highlight, TweenInfo.new(duration), { FillTransparency = 1 }):Play()
	Debris:AddItem(highlight, duration + 0.05)
	if kind == "Hit" or kind == "ParrySuccess" or kind == "Parried" then
		local gui = Instance.new("BillboardGui")
		gui.Adornee, gui.Size, gui.StudsOffset = root, UDim2.fromOffset(130, 38), Vector3.new(0, 3.5, 0)
		gui.AlwaysOnTop, gui.Parent = true, root
		local text = Instance.new("TextLabel")
		text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		text.Font, text.TextSize = Enum.Font.GothamBold, 22
		text.TextColor3 = colors[kind]
		text.Text = if kind == "Hit" then "-" .. tostring(payload.extra) elseif kind == "Parried" then "STUNNED" else "PARRY"
		text.Parent = gui
		TweenService:Create(gui, TweenInfo.new(0.65), { StudsOffset = Vector3.new(0, 5.5, 0) }):Play()
		TweenService:Create(text, TweenInfo.new(0.65), { TextTransparency = 1 }):Play()
		Debris:AddItem(gui, 0.7)
	end
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Catalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Catalog)

local Hud = {}

local function make(class, parent, properties)
	local object = Instance.new(class)
	for key, value in properties do object[key] = value end
	object.Parent = parent
	return object
end

local function label(parent, text, position, size, fontSize)
	return make("TextLabel", parent, {
		Text = text, Position = position, Size = size, BackgroundTransparency = 1,
		TextColor3 = Color3.fromRGB(226, 236, 246), Font = Enum.Font.Gotham,
		TextSize = fontSize or 14, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
	})
end

local function button(parent, text, position, size, callback)
	local object = make("TextButton", parent, {
		Text = text, Position = position, Size = size, BackgroundColor3 = Color3.fromRGB(46, 62, 76),
		TextColor3 = Color3.fromRGB(231, 244, 249), Font = Enum.Font.GothamMedium,
		TextSize = 13, BorderSizePixel = 0, AutoButtonColor = true,
	})
	make("UICorner", object, { CornerRadius = UDim.new(0, 7) })
	object.Activated:Connect(callback)
	return object
end

function Hud.new(callbacks)
	local player = Players.LocalPlayer
	local gui = make("ScreenGui", player:WaitForChild("PlayerGui"), { Name = "SystemsHud", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
	local root = make("Frame", gui, { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	local top = make("Frame", root, { Position = UDim2.fromOffset(18, 16), Size = UDim2.fromOffset(280, 116), BackgroundColor3 = Color3.fromRGB(18, 25, 35), BorderSizePixel = 0 })
	make("UICorner", top, { CornerRadius = UDim.new(0, 10) })
	label(top, "KURODAKOO / SYSTEMS LAB", UDim2.fromOffset(14, 10), UDim2.fromOffset(252, 22), 15).Font = Enum.Font.GothamBold
	local stats = label(top, "Loading profile...", UDim2.fromOffset(14, 38), UDim2.fromOffset(252, 24), 16)
	local health = label(top, "", UDim2.fromOffset(14, 65), UDim2.fromOffset(252, 20), 13)
	local mode = label(top, "", UDim2.fromOffset(14, 88), UDim2.fromOffset(252, 18), 11)
	mode.TextColor3 = Color3.fromRGB(142, 162, 179)
	local panel = make("Frame", root, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 64), Size = UDim2.fromOffset(310, 468), BackgroundColor3 = Color3.fromRGB(18, 25, 35), BorderSizePixel = 0, Visible = false })
	make("UICorner", panel, { CornerRadius = UDim.new(0, 10) })
	label(panel, "INVENTORY & WORKSHOP", UDim2.fromOffset(16, 14), UDim2.fromOffset(278, 24), 16).Font = Enum.Font.GothamBold
	label(panel, "Buy at the supply station. Build on your plot.", UDim2.fromOffset(16, 42), UDim2.fromOffset(278, 32), 12)
	local counts = {}
	for index, id in { "Crate", "Bench", "Lamp", "Medkit" } do
		local y = 84 + (index - 1) * 54
		counts[id] = label(panel, Catalog[id].name, UDim2.fromOffset(16, y), UDim2.fromOffset(142, 22), 13)
		button(panel, "$" .. Catalog[id].price, UDim2.fromOffset(166, y), UDim2.fromOffset(55, 34), function() callbacks.buy(id) end)
		button(panel, if id == "Medkit" then "Use" else "Build", UDim2.fromOffset(228, y), UDim2.fromOffset(66, 34), function() callbacks.select(id) end)
	end
	local selected = label(panel, "Combat mode", UDim2.fromOffset(16, 302), UDim2.fromOffset(278, 24), 14)
	button(panel, "Place / R2", UDim2.fromOffset(16, 336), UDim2.fromOffset(88, 34), callbacks.place)
	button(panel, "Rotate / R", UDim2.fromOffset(111, 336), UDim2.fromOffset(88, 34), callbacks.rotate)
	button(panel, "Pick up / X", UDim2.fromOffset(206, 336), UDim2.fromOffset(88, 34), callbacks.remove)
	button(panel, "Combat mode", UDim2.fromOffset(16, 378), UDim2.fromOffset(278, 30), callbacks.cancel)
	local quest = button(panel, "Contract: defeat 3 sentinels", UDim2.fromOffset(16, 418), UDim2.fromOffset(278, 34), callbacks.claim)
	button(root, "Inventory / Tab / Y", UDim2.new(1, -198, 0, 16), UDim2.fromOffset(180, 36), function() panel.Visible = not panel.Visible end)
	local help = label(root, "LMB / R2  Attack     E / X  Heavy     F / L2  Parry     Q / B  Dash\nTab / Y  Inventory     H / D-pad up  Medkit", UDim2.new(0, 18, 1, -68), UDim2.fromOffset(580, 48), 13)
	local notice = label(root, "Fight the sentinels in the red arena. Open your inventory to build.", UDim2.new(0.5, -270, 0, 142), UDim2.fromOffset(540, 52), 14)
	notice.TextXAlignment, notice.TextStrokeTransparency = Enum.TextXAlignment.Center, 0.4
	local cursor = label(root, "+", UDim2.new(0.5, -10, 0.5, -10), UDim2.fromOffset(20, 20), 24)
	cursor.TextXAlignment, cursor.Visible = Enum.TextXAlignment.Center, false
	local panelScale = make("UIScale", panel, { Scale = 1 })
	local topScale = make("UIScale", top, { Scale = 1 })
	local function resize()
		local size = workspace.CurrentCamera.ViewportSize
		panelScale.Scale = math.clamp((size.Y - 105) / 468, 0.45, 1)
		topScale.Scale = if size.X < 650 then 0.75 else 1
		help.Visible = size.X > 700
		notice.Size = UDim2.new(1, -36, 0, 52)
		notice.Position = UDim2.new(0, 18, 0, if size.X < 650 then 108 else 142)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize)
	resize()
	local serial = 0
	return {
		toggle = function() panel.Visible = not panel.Visible end,
		open = function() panel.Visible = true end,
		selection = function(id)
			selected.Text = if id then "Building: " .. Catalog[id].name else "Combat mode"
			cursor.Visible = id ~= nil
		end,
		profile = function(data)
			stats.Text = string.format("%d credits  /  %d defeats", data.coins, data.kills)
			mode.Text = player:GetAttribute("DataMode") or ""
			for id, text in counts do text.Text = Catalog[id].name .. "  x" .. (data.inventory[id] or 0) end
			quest.Text = if data.questClaimed then "Contract completed" elseif data.kills >= 3 then "Claim 150 credits" else "Contract: " .. data.kills .. "/3 sentinels"
		end,
		health = function(current, maximum) health.Text = string.format("Health  %d / %d", math.ceil(current), maximum) end,
		notice = function(message)
			serial += 1
			local ticket = serial
			notice.Text = message
			task.delay(4, function() if serial == ticket then notice.Text = "" end end)
		end,
	}
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="26">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Grid = require(Shared.Grid)
local Settings = require(Shared.Settings)
local Hud = require(script.Parent.Hud)
local Effects = require(script.Parent.Effects)
local remote = ReplicatedStorage:WaitForChild("SystemsEvent")

local profile, selection, ghost, candidate, hud
local rotation = 0
local healthConnection
local previousRay

local function send(action, payload)
	remote:FireServer(action, payload)
end

local function selectItem(id)
	if id == "Medkit" then send("Heal") return end
	selection, candidate, rotation = id, nil, 0
	if ghost then ghost:Destroy() ghost = nil end
	if id then
		ghost = Instance.new("Part")
		ghost.Name, ghost.Anchored = "PlacementPreview", true
		ghost.CanCollide, ghost.CanTouch, ghost.CanQuery = false, false, false
		ghost.Material, ghost.Transparency = Enum.Material.ForceField, 0.35
		ghost.Parent = workspace
	end
	if hud then hud.selection(id) end
end

local function aimRay()
	local camera = workspace.CurrentCamera
	local input = UserInputService:GetLastInputType()
	local mouse = UserInputService:GetMouseLocation()
	local center = input == Enum.UserInputType.Touch or string.find(input.Name, "Gamepad") ~= nil
	if not center then
		for _, object in player.PlayerGui:GetGuiObjectsAtPosition(mouse.X, mouse.Y) do
			if object:IsA("GuiButton") then
				return previousRay or camera:ViewportPointToRay(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
			end
		end
	end
	local point = if center then camera.ViewportSize / 2 else mouse
	previousRay = camera:ViewportPointToRay(point.X, point.Y)
	return previousRay
end

local function place()
	if selection and candidate then
		send("Place", { item = selection, x = candidate.x, z = candidate.z, rotation = rotation })
	end
end

local function remove()
	local ray = aimRay()
	local filter = RaycastParams.new()
	filter.FilterType = Enum.RaycastFilterType.Exclude
	filter.FilterDescendantsInstances = if player.Character then { player.Character } else {}
	local result = workspace:Raycast(ray.Origin, ray.Direction * 150, filter)
	if result and result.Instance:GetAttribute("Owner") == player.UserId then
		local id = result.Instance:GetAttribute("PieceId")
		if id then send("Remove", { id = id }) end
	end
end

local function rotate()
	rotation = (rotation + 1) % 4
end

hud = Hud.new({
	buy = function(id) send("Buy", { item = id }) end,
	select = selectItem, place = place, rotate = rotate, remove = remove,
	cancel = function() selectItem(nil) end,
	claim = function() send("ClaimQuest") end,
})

remote.OnClientEvent:Connect(function(kind, payload)
	if kind == "Profile" then
		profile = payload
		hud.profile(payload)
	elseif kind == "Notice" then
		hud.notice(payload)
	elseif kind == "Effect" then
		Effects.play(payload)
	elseif kind == "Shop" then
		hud.open()
	end
end)

local function characterAdded(character)
	selectItem(nil)
	if healthConnection then healthConnection:Disconnect() end
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid or player.Character ~= character then return end
	local function refresh() hud.health(humanoid.Health, humanoid.MaxHealth) end
	healthConnection = humanoid.HealthChanged:Connect(refresh)
	refresh()
end

player.CharacterAdded:Connect(characterAdded)
if player.Character then task.spawn(characterAdded, player.Character) end
player:GetAttributeChangedSignal("DataMode"):Connect(function() if profile then hud.profile(profile) end end)

local function primary()
	if selection then place() else send("Light") end
end

local bindings = {
	{ "Attack", "Attack", primary, Enum.KeyCode.ButtonR2 },
	{ "Heavy", "Heavy", function() if selection then rotate() else send("Heavy") end end, Enum.KeyCode.E, Enum.KeyCode.ButtonX },
	{ "Parry", "Parry", function() if selection then remove() else send("Parry") end end, Enum.KeyCode.F, Enum.KeyCode.ButtonL2 },
	{ "Dash", "Dash", function() if selection then selectItem(nil) else send("Dash") end end, Enum.KeyCode.Q, Enum.KeyCode.ButtonB },
	{ "Inventory", "Bag", hud.toggle, Enum.KeyCode.Tab, Enum.KeyCode.ButtonY },
	{ "Heal", "Heal", function() send("Heal") end, Enum.KeyCode.H, Enum.KeyCode.DPadUp },
	{ "Rotate", "", rotate, Enum.KeyCode.R },
	{ "Pickup", "", remove, Enum.KeyCode.X },
}

for index, binding in bindings do
	local name, title, callback = binding[1], binding[2], binding[3]
	local keys = {}
	for keyIndex = 4, #binding do table.insert(keys, binding[keyIndex]) end
	ContextActionService:BindAction(name, function(_, state)
		if UserInputService:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
		if state == Enum.UserInputState.Begin then callback() end
		return Enum.ContextActionResult.Sink
	end, index <= 6, table.unpack(keys))
	if index <= 6 then
		ContextActionService:SetTitle(name, title)
		local column, row = (index - 1) % 3, math.floor((index - 1) / 3)
		ContextActionService:SetPosition(name, UDim2.new(1, -240 + column * 72, 1, -230 + row * 72))
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then primary() end
end)

RunService.RenderStepped:Connect(function()
	if not selection or not ghost or not profile then return end
	local position = player:GetAttribute("PlotPosition")
	if not position then ghost.Transparency = 1 candidate = nil return end
	local ray = aimRay()
	if math.abs(ray.Direction.Y) < 0.001 then ghost.Transparency = 1 candidate = nil return end
	local distance = (position.Y + 0.25 - ray.Origin.Y) / ray.Direction.Y
	if distance < 0 or distance > 200 then ghost.Transparency = 1 candidate = nil return end
	local point = ray.Origin + ray.Direction * distance - position
	local x = math.floor((point.X + 16) / 4) + 1
	local z = math.floor((point.Z + 16) / 4) + 1
	local item = Catalog[selection]
	local width, depth = Grid.dimensions(item, rotation)
	local centerX, centerZ = Grid.center(x, z, width, depth, Settings.Grid.cells, Settings.Grid.size)
	local valid = Grid.fits(profile.builds, Catalog, selection, x, z, rotation, Settings.Grid.cells)
	valid = valid and (profile.inventory[selection] or 0) > 0
	ghost.Size = Vector3.new(item.width * 4 - 0.16, item.height, item.depth * 4 - 0.16)
	ghost.CFrame = CFrame.new(position + Vector3.new(centerX, 0.25 + item.height / 2, centerZ)) * CFrame.Angles(0, -rotation * math.pi / 2, 0)
	ghost.Color = if valid then Color3.fromRGB(105, 242, 195) else Color3.fromRGB(255, 95, 117)
	ghost.Transparency = 0.35
	candidate = { x = x, z = z }
end)

task.spawn(function()
	while not profile do
		send("Sync")
		task.wait(2)
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="27">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="FilteringEnabled">true</bool>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>