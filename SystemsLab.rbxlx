      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">BuildService</string>
          <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Settings = require(Shared.Settings)
local Catalog = require(Shared.Catalog)
local Grid = require(Shared.Grid)
local Economy = require(script.Parent.core.Economy)
local World = require(script.Parent.World)

local BuildService = {}
BuildService.__index = BuildService

function BuildService.new(data, world)
	return setmetatable({ data = data, world = world, plots = {}, slots = {} }, BuildService)
end

function BuildService:render(player, piece)
	local plot = self.plots[player]
	local item = Catalog[piece.item]
	local width, depth = Grid.dimensions(item, piece.rotation)
	local x, z = Grid.center(piece.x, piece.z, width, depth, Settings.Grid.cells, Settings.Grid.size)
	local colors = { Crate = Color3.fromRGB(173, 124, 76), Bench = Color3.fromRGB(91, 141, 157), Lamp = Color3.fromRGB(121, 237, 200) }
	local part = World.part(plot.folder, tostring(piece.id), Vector3.new(item.width * 4 - 0.16, item.height, item.depth * 4 - 0.16), Vector3.zero, colors[piece.item])
	part.CFrame = plot.base.CFrame * CFrame.new(x, plot.base.Size.Y / 2 + item.height / 2, z) * CFrame.Angles(0, -piece.rotation * math.pi / 2, 0)
	part:SetAttribute("PieceId", piece.id)
	part:SetAttribute("Owner", player.UserId)
	if piece.item == "Lamp" then
		part.Material = Enum.Material.Neon
		local light = Instance.new("PointLight")
		light.Color, light.Range, light.Brightness, light.Parent = colors.Lamp, 16, 1.5, part
	end
end

function BuildService:add(player)
	local data = self.data:get(player)
	if not data then return end
	local slot = 1
	while self.slots[slot] do slot += 1 end
	self.slots[slot] = player
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Plot_" .. player.UserId, self.world.folder
	local base = World.part(folder, "Base", Vector3.new(32, 0.5, 32), Vector3.new(40, 0.25, (slot - 1) * 42), Color3.fromRGB(49, 66, 73))
	base:SetAttribute("Owner", player.UserId)
	World.label(base, player.DisplayName .. "'s plot\n03 / GRID PLACEMENT")
	for cell = 0, 8 do
		local offset = -16 + cell * 4
		World.part(folder, "Grid", Vector3.new(0.04, 0.02, 32), base.Position + Vector3.new(offset, 0.26, 0), Color3.fromRGB(85, 109, 115)).CanCollide = false
		World.part(folder, "Grid", Vector3.new(32, 0.02, 0.04), base.Position + Vector3.new(0, 0.26, offset), Color3.fromRGB(85, 109, 115)).CanCollide = false
	end
	self.plots[player] = { base = base, folder = folder, slot = slot }
	for _, piece in data.builds do self:render(player, piece) end
	player:SetAttribute("PlotPosition", base.Position)
end

function BuildService:near(player)
	local plot = self.plots[player]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return plot and root and humanoid and humanoid.Health > 0
		and (root.Position - plot.base.Position).Magnitude <= Settings.Grid.reach
end

function BuildService:place(player, payload)
	local data = self.data:get(player)
	if not data or not self:near(player) then return false, "Move closer to your plot." end
	if type(payload.item) ~= "string" or #payload.item > 24 then return false end
	local piece, reason = Economy.place(data, Catalog, Grid, payload.item, payload.x, payload.z, payload.rotation)
	if not piece then return false, reason end
	self:render(player, piece)
	return true, "Placed " .. Catalog[piece.item].name .. "."
end

function BuildService:remove(player, payload)
	local data = self.data:get(player)
	if not data or not self:near(player) then return false, "Move closer to your plot." end
	if not Grid.integer(payload.id, 1, 1000000000) then return false end
	local ok, reason = Economy.remove(data, payload.id)
	if ok then
		local part = self.plots[player].folder:FindFirstChild(tostring(payload.id))
		if part then part:Destroy() end
	end
	return ok, reason
end

function BuildService:cleanup(player)
	local plot = self.plots[player]
	if not plot then return end
	self.slots[plot.slot] = nil
	plot.folder:Destroy()
	self.plots[player] = nil
end

return BuildService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Settings = require(Shared.Settings)
local CombatState = require(script.Parent.core.CombatState)

local CombatService = {}
CombatService.__index = CombatService

function CombatService.new(remote, reward)
	return setmetatable({ actors = {}, remote = remote, reward = reward }, CombatService)
end

function CombatService:register(model, npc)
	local root = model:WaitForChild("HumanoidRootPart", 10)
	local humanoid = model:WaitForChild("Humanoid", 10)
	if not root or not humanoid or not model.Parent then return end
	local actor = { model = model, root = root, humanoid = humanoid, npc = npc, state = CombatState.new() }
	self.actors[model] = actor
	actor.died = humanoid.Died:Connect(function()
		if npc and actor.lastAttacker and os.clock() - (actor.lastHit or 0) <= 8 then
			self.reward(actor.lastAttacker)
		end
		self:unregister(model)
	end)
	return actor
end

function CombatService:unregister(model)
	local actor = self.actors[model]
	if not actor then return end
	actor.state.serial += 1
	if actor.movement then
		actor.humanoid.WalkSpeed, actor.humanoid.JumpPower, actor.humanoid.JumpHeight = table.unpack(actor.movement)
	end
	actor.died:Disconnect()
	self.actors[model] = nil
end

function CombatService:stun(actor, duration)
	CombatState.stun(actor.state, os.clock(), duration)
	if not actor.movement then
		actor.movement = { actor.humanoid.WalkSpeed, actor.humanoid.JumpPower, actor.humanoid.JumpHeight }
	end
	actor.humanoid.WalkSpeed, actor.humanoid.JumpPower, actor.humanoid.JumpHeight = 0, 0, 0
	task.delay(duration, function()
		if self.actors[actor.model] == actor and actor.movement and os.clock() >= actor.state.stunUntil then
			actor.humanoid.WalkSpeed, actor.humanoid.JumpPower, actor.humanoid.JumpHeight = table.unpack(actor.movement)
			actor.movement = nil
		end
	end)
end

function CombatService:effect(kind, model, extra)
	local root = model:FindFirstChild("HumanoidRootPart")
	if not root then return end
	for _, player in Players:GetPlayers() do
		local observer = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if observer and (observer.Position - root.Position).Magnitude < 150 then
			self.remote:FireClient(player, "Effect", { kind = kind, model = model, extra = extra })
		end
	end
end

function CombatService:hostile(attacker, target)
	return attacker ~= target and target.humanoid.Health > 0 and target.model.Parent
		and (attacker.npc ~= target.npc or (Settings.Combat.pvp and not attacker.npc))
end

function CombatService:hit(attacker, target, move)
	local now = os.clock()
	local offset = attacker.root.Position - target.root.Position
	local facing = if offset.Magnitude > 0.01 then target.root.CFrame.LookVector:Dot(offset.Unit) else 1
	local defense = CombatState.defense(target.state, now, facing)
	if defense == "Dodge" then return end
	if defense == "Parry" then
		target.state.parryUntil = 0
		self:stun(attacker, Settings.Combat.parryStun)
		self:effect("Parried", attacker.model)
		self:effect("ParrySuccess", target.model)
		return
	end
	self:stun(target, Settings.Combat.stun)
	if not attacker.npc and target.npc then
		target.lastAttacker = Players:GetPlayerFromCharacter(attacker.model)
		target.lastHit = now
	end
	target.humanoid:TakeDamage(move.damage)
	self:effect("Hit", target.model, move.damage)
	if move.combo == 4 and offset.Magnitude > 0.01 then
		local horizontal = Vector3.new(-offset.X, 0, -offset.Z)
		if horizontal.Magnitude > 0.01 then
			target.root:ApplyImpulse((horizontal.Unit * 30 + Vector3.new(0, 8, 0)) * target.root.AssemblyMass)
		end
	end
end

function CombatService:strike(actor, move)
	-- A stun or respawn invalidates an attack already waiting on its windup.
	if self.actors[actor.model] ~= actor or actor.humanoid.Health <= 0 or actor.state.serial ~= move.serial then return end
	local include = {}
	for _, target in self.actors do
		if self:hostile(actor, target) then table.insert(include, target.model) end
	end
	if #include == 0 then return end
	local overlap = OverlapParams.new()
	overlap.FilterType, overlap.FilterDescendantsInstances = Enum.RaycastFilterType.Include, include
	local parts = workspace:GetPartBoundsInBox(actor.root.CFrame * CFrame.new(0, 0, -3.5), Vector3.new(6, 5, 6), overlap)
	local hit = {}
	local ray = RaycastParams.new()
	ray.FilterType, ray.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { actor.model }
	for _, part in parts do
		if actor.state.serial ~= move.serial then break end
		local model = part:FindFirstAncestorOfClass("Model")
		local target = model and self.actors[model]
		if target and not hit[target] and self:hostile(actor, target) then
			hit[target] = true
			local delta = target.root.Position - actor.root.Position
			if delta.Magnitude <= 8 then
				local obstruction = workspace:Raycast(actor.root.Position, delta, ray)
				if not obstruction or obstruction.Instance:IsDescendantOf(target.model) then
					self:hit(actor, target, move)
				end
			end
		end
	end
end

function CombatService:dash(actor)
	local direction = actor.root.CFrame.LookVector * Settings.Combat.dashDistance
	local ray = RaycastParams.new()
	ray.FilterType, ray.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { actor.model }
	ray.RespectCanCollide = true
	local obstruction = workspace:Blockcast(actor.root.CFrame, Vector3.new(2, 3, 2), direction, ray)
	local distance = if obstruction then math.max(0, obstruction.Distance - 0.5) else direction.Magnitude
	actor.model:PivotTo(actor.model:GetPivot() + direction.Unit * distance)
end

function CombatService:act(model, action)
	local actor = self.actors[model]
	if not actor or actor.humanoid.Health <= 0 then return false end
	local config = Settings.Combat
	if actor.npc then
		config = table.clone(config)
		config.lightWindup, config.lightRecovery = 0.65, 1.0
		config.lightDamage = { 8, 8, 8, 12 }
	end
	local move = CombatState.begin(actor.state, action, os.clock(), config)
	if not move then return false end
	self:effect(action, model, { combo = move.combo, windup = move.windup })
	if action == "Dash" then
		self:dash(actor)
	elseif move.damage > 0 then
		task.delay(move.windup, function() self:strike(actor, move) end)
	end
	return true
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")

local Profile = require(script.Parent.core.Profile)
local Lease = require(script.Parent.core.Lease)
local Catalog = require(Shared.Catalog)
local Grid = require(Shared.Grid)

local STUDIO_SAVING = false
local STORE_NAME = "KurodakooSystemsLab_v1"
local LEASE_SECONDS = 180
local SAVE_INTERVAL = 45

local DataService = {}
DataService.__index = DataService

function DataService.new()
	local persistent = not RunService:IsStudio() or STUDIO_SAVING
	return setmetatable({
		sessions = {}, loading = {}, closing = false, persistent = persistent,
		store = if persistent then DataStoreService:GetDataStore(STORE_NAME) else nil,
	}, DataService)
end

function DataService:get(player)
	local session = self.sessions[player]
	if session and session.active and not session.closing and os.time() < session.expires then
		return session.data
	end
	return nil
end

function DataService:load(player)
	if self.closing or self.loading[player] or self.sessions[player] then
		return false
	end
	self.loading[player] = true
	local token = HttpService:GenerateGUID(false)
	local data, expires
	local failure = "Your previous session is still saving. Please rejoin shortly."
	if not self.persistent then
		data, expires = Profile.new(), math.huge
	else
		for attempt = 1, 5 do
			if self.closing or player.Parent ~= Players then break end
			local now = os.time()
			local ok, result = pcall(function()
				return self.store:UpdateAsync("Player_" .. player.UserId, function(record)
					if record ~= nil and (type(record) ~= "table" or not Profile.decode(record.data, Catalog, Grid)) then
						error("Saved data did not pass schema validation")
					end
					return Lease.claim(record, token, now, LEASE_SECONDS, Profile.new)
				end)
			end)
			if ok and result and result.lock and result.lock.owner == token then
				data = Profile.decode(result.data, Catalog, Grid)
				expires = result.lock.expires
				break
			end
			if not ok then
				warn("Profile load failed:", result)
				failure = "Your data could not be loaded safely. Please try again shortly."
			end
			if attempt < 5 then task.wait(math.min(2 ^ (attempt - 1), 6) + math.random()) end
		end
	end
	if data then
		self.sessions[player] = {
			data = data, token = token, expires = expires, active = true, saving = false, closing = false,
			nextSave = os.clock() + SAVE_INTERVAL + math.random(0, 10),
		}
	end
	self.loading[player] = nil
	if not data then
		if player.Parent == Players then player:Kick(failure) end
		return false
	end
	if self.closing or player.Parent ~= Players then
		self:release(player)
		return false
	end
	player:SetAttribute("DataMode", if self.persistent then "Saved profile" else "Studio session (not saved)")
	return true
end

function DataService:save(player, release)
	local session = self.sessions[player]
	if not session or not session.active then return false end
	if release then session.closing = true end
	if session.saving then
		if not release then return false end
		-- The final snapshot must follow any in-flight autosave.
		repeat task.wait(0.05) until not session.saving
	end
	if not session.active then return false end
	session.saving = true
	local saved = not self.persistent
	local snapshot = Profile.copy(session.data)
	if self.persistent then
		for attempt = 1, 3 do
			local now = os.time()
			if now >= session.expires then break end
			local ok, result = pcall(function()
				return self.store:UpdateAsync("Player_" .. player.UserId, function(record)
					return Lease.commit(record, session.token, now, LEASE_SECONDS, snapshot, release)
				end)
			end)
			if ok then
				if result and ((release and result.lock == nil)
					or (not release and result.lock and result.lock.owner == session.token)) then
					saved = true
					session.expires = now + LEASE_SECONDS
				else
					session.active = false
				end
				break
			end
			warn("Profile save failed:", result)
			if attempt < 3 then task.wait(2 ^ (attempt - 1) + math.random()) end
		end
	end
	if release then session.active = false end
	session.saving = false
	session.nextSave = os.clock() + (if saved then SAVE_INTERVAL else 10)
	if not release and (not session.active or os.time() >= session.expires - 25) then
		session.active = false
		player:Kick("Saving is unavailable. Please rejoin shortly to protect your profile.")
	end
	return saved
end

function DataService:release(player)
	local session = self.sessions[player]
	if not session or session.releasing then return end
	session.releasing = true
	local saved = self:save(player, true)
	if not saved and self.persistent then warn("Final save failed for user", player.UserId) end
	self.sessions[player] = nil
end

function DataService:start()
	task.spawn(function()
		while not self.closing do
			task.wait(5)
			for player, session in self.sessions do
				if session.active and not session.saving and not session.closing and os.clock() >= session.nextSave then
					task.spawn(function() self:save(player, false) end)
				end
			end
		end
	end)
	game:BindToClose(function()
		self.closing = true
		for player in self.sessions do task.spawn(function() self:release(player) end) end
		local deadline = os.clock() + 25
		while (next(self.sessions) or next(self.loading)) and os.clock() < deadline do task.wait(0.1) end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Catalog = require(ReplicatedStorage.Shared.Catalog)
local Profile = require(script.Parent.core.Profile)
local Economy = require(script.Parent.core.Economy)
local RateLimiter = require(script.Parent.core.RateLimiter)
local DataService = require(script.Parent.DataService)
local BuildService = require(script.Parent.BuildService)
local CombatService = require(script.Parent.CombatService)
local SentinelService = require(script.Parent.SentinelService)
local World = require(script.Parent.World)

local remote = Instance.new("RemoteEvent")
remote.Name, remote.Parent = "SystemsEvent", ReplicatedStorage

local world = World.create()
local data = DataService.new()
local builds = BuildService.new(data, world)
local limiter = RateLimiter.new(18, 10)
local connections = {}
local actions = { Light = true, Heavy = true, Parry = true, Dash = true }

local function sendProfile(player)
	local profile = data:get(player)
	if profile then remote:FireClient(player, "Profile", Profile.copy(profile)) end
end

local function notify(player, message)
	if message then remote:FireClient(player, "Notice", message) end
end

local combat = CombatService.new(remote, function(player)
	local profile = data:get(player)
	if not profile then return end
	profile.kills = math.min(1000000000, profile.kills + 1)
	profile.coins = math.min(1000000000, profile.coins + 25)
	notify(player, "Sentinel defeated. +25 credits.")
	sendProfile(player)
end)

local function alive(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return humanoid and humanoid.Health > 0 and root, humanoid
end

remote.OnServerEvent:Connect(function(player, action, payload)
	if not limiter:allow(player.UserId, os.clock()) then return end
	if type(action) ~= "string" or #action > 24 then return end
	local profile = data:get(player)
	if not profile then return end
	if action == "Sync" then sendProfile(player) return end
	if actions[action] then
		if player.Character then combat:act(player.Character, action) end
		return
	end
	local ok, message
	if action == "Buy" then
		if type(payload) ~= "table" or type(payload.item) ~= "string" or #payload.item > 24 then return end
		local root = alive(player)
		if not root or (root.Position - world.shop.Position).Magnitude > 16 then
			notify(player, "Visit the blue supply station to buy items.")
			return
		end
		ok, message = Economy.buy(profile, Catalog, payload.item)
	elseif action == "Heal" then
		local root, humanoid = alive(player)
		if not root then return end
		if humanoid.Health >= humanoid.MaxHealth then notify(player, "You're already at full health.") return end
		if (profile.inventory.Medkit or 0) < 1 then notify(player, "No medkits left.") return end
		profile.inventory.Medkit -= 1
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + Catalog.Medkit.heal)
		ok, message = true, "Used one medkit."
	elseif action == "Place" or action == "Remove" then
		if type(payload) ~= "table" then return end
		if action == "Place" then ok, message = builds:place(player, payload)
		else ok, message = builds:remove(player, payload) end
	elseif action == "ClaimQuest" then
		ok, message = Economy.claimQuest(profile)
	else
		return
	end
	notify(player, message)
	if ok then sendProfile(player) end
end)

world.prompt.Triggered:Connect(function(player)
	local root = alive(player)
	if root and (root.Position - world.shop.Position).Magnitude <= 16 then
		remote:FireClient(player, "Shop")
	end
end)

local function joined(player)
	if connections[player] then return end
	connections[player] = {}
	if not data:load(player) then connections[player] = nil return end
	builds:add(player)
	local list = connections[player]
	if not list then return end
	local function characterAdded(character)
		if combat.actors[character] then return end
		local actor = combat:register(character, false)
		if actor and player.Character ~= character then combat:unregister(character) end
	end
	table.insert(list, player.CharacterAdded:Connect(characterAdded))
	table.insert(list, player.CharacterRemoving:Connect(function(character) combat:unregister(character) end))
	if player.Character then task.spawn(characterAdded, player.Character) end
	sendProfile(player)
end

Players.PlayerAdded:Connect(joined)
Players.PlayerRemoving:Connect(function(player)
	for _, connection in connections[player] or {} do connection:Disconnect() end
	connections[player] = nil
	if player.Character then combat:unregister(player.Character) end
	builds:cleanup(player)
	limiter:remove(player.UserId)
	data:release(player)
end)
for _, player in Players:GetPlayers() do task.spawn(joined, player) end
data:start()
SentinelService.start(combat, world)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">SentinelService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local World = require(script.Parent.World)

local SentinelService = {}

function SentinelService.start(combat, world)
	local running = true
	game:BindToClose(function() running = false end)
	for _, offset in { Vector3.new(-7, 3, -5), Vector3.new(7, 3, 5) } do
		task.spawn(function()
			local home = world.arena + offset
			while running do
				local model = World.sentinel(world.folder, home)
				local actor = combat:register(model, true)
				if not actor then model:Destroy() return end
				while running and actor.humanoid.Health > 0 and model.Parent do
					local nearest, distance = nil, 22
					for _, player in Players:GetPlayers() do
						local target = player.Character and combat.actors[player.Character]
						if target and target.humanoid.Health > 0 and (target.root.Position - home).Magnitude < 24 then
							local gap = (target.root.Position - actor.root.Position).Magnitude
							if gap < distance then nearest, distance = target, gap end
						end
					end
					local now = os.clock()
					if now < actor.state.stunUntil or now < actor.state.busyUntil then
						actor.humanoid:MoveTo(actor.root.Position)
					elseif nearest then
						if distance < 5.5 then
							local aim = Vector3.new(nearest.root.Position.X, actor.root.Position.Y, nearest.root.Position.Z)
							if (aim - actor.root.Position).Magnitude > 0.01 then actor.root.CFrame = CFrame.lookAt(actor.root.Position, aim) end
							combat:act(model, "Light")
						else
							actor.humanoid:MoveTo(nearest.root.Position)
						end
					else
						actor.humanoid:MoveTo(home)
						if (actor.root.Position - home).Magnitude < 3 then actor.humanoid.Health = math.min(100, actor.humanoid.Health + 3) end
					end
					task.wait(0.1)
				end
				combat:unregister(model)
				task.wait(2)
				model:Destroy()
				task.wait(2)
			end
		end)
	end
end

return SentinelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local World = {}

function World.part(parent, name, size, position, color, material)
	local part = Instance.new("Part")
	part.Name, part.Size, part.Position = name, size, position
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

function World.label(part, text, color)
	local gui = Instance.new("BillboardGui")
	gui.Size, gui.StudsOffset = UDim2.fromOffset(260, 68), Vector3.new(0, 5, 0)
	gui.MaxDistance = 120
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text, label.TextColor3 = text, color or Color3.fromRGB(230, 239, 248)
	label.Font, label.TextSize = Enum.Font.GothamBold, 20
	label.TextStrokeTransparency = 0.5
	label.Parent = gui
end

function World.create()
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "SystemsLab", workspace
	local slate = Color3.fromRGB(35, 44, 58)
	World.part(folder, "Floor", Vector3.new(220, 2, 460), Vector3.new(0, -1, 165), slate)
	World.part(folder, "Arena", Vector3.new(52, 0.3, 52), Vector3.new(-42, 0.15, 0), Color3.fromRGB(58, 42, 49))
	local marker = World.part(folder, "CombatStation", Vector3.new(2, 5, 2), Vector3.new(-42, 2.5, -26), Color3.fromRGB(255, 126, 91))
	World.label(marker, "01 / COMBAT\nFight the sentinels")
	local spawn = Instance.new("SpawnLocation")
	spawn.Size, spawn.Position = Vector3.new(10, 1, 10), Vector3.new(0, 0.5, 24)
	spawn.Anchored, spawn.Neutral, spawn.Duration = true, true, 0
	spawn.Color, spawn.Material = Color3.fromRGB(103, 226, 200), Enum.Material.Neon
	spawn.Parent = folder
	World.label(spawn, "KURODAKOO\nSystems Lab")
	local shop = World.part(folder, "Shop", Vector3.new(10, 4, 5), Vector3.new(0, 2, -16), Color3.fromRGB(57, 104, 130))
	World.label(shop, "02 / INVENTORY\nShop, build, save")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText, prompt.ObjectText = "Open shop", "Supply station"
	prompt.HoldDuration, prompt.MaxActivationDistance = 0, 12
	prompt.Parent = shop
	return { folder = folder, shop = shop, prompt = prompt, arena = Vector3.new(-42, 0, 0) }
end

function World.sentinel(parent, position)
	local model = Instance.new("Model")
	model.Name = "Sentinel"
	local root = World.part(model, "HumanoidRootPart", Vector3.new(2, 2, 1), position, Color3.new())
	root.Transparency, root.CanCollide = 1, false
	local body = World.part(model, "Torso", Vector3.new(3, 4, 2), position, Color3.fromRGB(77, 91, 113))
	local head = World.part(model, "Head", Vector3.new(2, 1.5, 2), position + Vector3.new(0, 2.75, 0), Color3.fromRGB(255, 142, 101))
	for _, part in { body, head } do
		part.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = root, part, root
	end
	root.Anchored = false
	local humanoid = Instance.new("Humanoid")
	humanoid.RequiresNeck, humanoid.BreakJointsOnDeath = false, false
	humanoid.HipHeight, humanoid.WalkSpeed = 1, 9
	humanoid.MaxHealth, humanoid.Health = 100, 100
	humanoid.DisplayName = "Training sentinel"
	humanoid.Parent = model
	model.PrimaryPart, model.Parent = root, parent
	root:SetNetworkOwner(nil)
	return model
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">core</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">CombatState</string>
            <string name="Source"><![CDATA[--!strict

export type State = {
	combo: number, lastAttack: number, busyUntil: number, stunUntil: number,
	parryUntil: number, invulnerableUntil: number, serial: number,
	cooldowns: { [string]: number },
}

local CombatState = {}

function CombatState.new(): State
	return {
		combo = 0, lastAttack = -math.huge, busyUntil = 0, stunUntil = 0,
		parryUntil = 0, invulnerableUntil = 0, serial = 0, cooldowns = {},
	}
end

function CombatState.begin(state: State, action: string, now: number, config: any): (any?, string?)
	if now < state.stunUntil or now < state.busyUntil then
		return nil, "busy"
	end
	if now < (state.cooldowns[action] or 0) then
		return nil, "cooldown"
	end
	local move = { damage = 0, windup = 0, combo = 0, serial = state.serial + 1 }
	if action == "Light" then
		state.combo = if now - state.lastAttack > config.comboReset then 1 else state.combo % 4 + 1
		state.lastAttack = now
		local recovery = if state.combo == 4 then config.finisherRecovery else config.lightRecovery
		move.damage, move.windup, move.combo = config.lightDamage[state.combo], config.lightWindup, state.combo
		state.busyUntil = now + config.lightWindup + recovery
	elseif action == "Heavy" then
		state.combo = 0
		move.damage, move.windup = config.heavyDamage, config.heavyWindup
		state.busyUntil = now + config.heavyWindup + config.heavyRecovery
		state.cooldowns.Heavy = now + config.heavyCooldown
	elseif action == "Parry" then
		state.parryUntil = now + config.parryWindow
		state.busyUntil = now + config.parryRecovery
		state.cooldowns.Parry = now + config.parryCooldown
	elseif action == "Dash" then
		state.invulnerableUntil = now + config.dashInvulnerability
		state.busyUntil = now + 0.2
		state.cooldowns.Dash = now + config.dashCooldown
	else
		return nil, "unknown action"
	end
	state.serial += 1
	move.serial = state.serial
	return move
end

function CombatState.stun(state: State, now: number, duration: number)
	state.stunUntil = math.max(state.stunUntil, now + duration)
	state.parryUntil = 0
	state.serial += 1
	state.combo = 0
end

function CombatState.defense(state: State, now: number, facing: number): string
	if now < state.invulnerableUntil then
		return "Dodge"
	end
	if now < state.parryUntil and facing >= 0.25 then
		return "Parry"
	end
	return "Hit"
end

return CombatState
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict

local Economy = {}

function Economy.buy(data: any, catalog: any, itemId: string): (boolean, string)
	local item = catalog[itemId]
	if not item then
		return false, "Unknown item."
	end
	local count = data.inventory[itemId] or 0
	local owned = count
	for _, piece in data.builds do
		if piece.item == itemId then
			owned += 1
		end
	end
	if owned >= item.limit then
		return false, "You already own the maximum."
	end
	if data.coins < item.price then
		return false, "Not enough credits."
	end
	data.coins -= item.price
	data.inventory[itemId] = count + 1
	return true, "Bought " .. item.name .. "."
end

function Economy.place(data: any, catalog: any, grid: any, itemId: string, x: number, z: number, rotation: number): (any?, string?)
	if #data.builds >= 40 then
		return nil, "Your plot is full."
	end
	if (data.inventory[itemId] or 0) < 1 then
		return nil, "You don't own that item."
	end
	local fits, reason = grid.fits(data.builds, catalog, itemId, x, z, rotation, 8)
	if not fits then
		return nil, reason
	end
	local piece = { id = data.nextId, item = itemId, x = x, z = z, rotation = rotation }
	data.nextId += 1
	data.inventory[itemId] -= 1
	table.insert(data.builds, piece)
	return piece
end

function Economy.remove(data: any, id: number): (boolean, string)
	for index, piece in data.builds do
		if piece.id == id then
			data.inventory[piece.item] = (data.inventory[piece.item] or 0) + 1
			table.remove(data.builds, index)
			return true, "Returned to inventory."
		end
	end
	return false, "That item is no longer on your plot."
end

function Economy.claimQuest(data: any): (boolean, string)
	if data.questClaimed then
		return false, "Reward already claimed."
	end
	if data.kills < 3 then
		return false, "Defeat three sentinels first."
	end
	data.questClaimed = true
	data.coins = math.min(1000000000, data.coins + 150)
	return true, "Contract complete. +150 credits."
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Lease</string>
            <string name="Source"><![CDATA[--!strict

local Lease = {}

function Lease.claim(record: any, owner: string, now: number, duration: number, fresh: () -> any): any?
	local value = record or { data = fresh() }
	if type(value) ~= "table" or type(value.data) ~= "table" then
		error("Invalid saved record")
	end
	local lock = value.lock
	if lock ~= nil and (type(lock) ~= "table" or type(lock.owner) ~= "string" or type(lock.expires) ~= "number") then
		error("Invalid session lock")
	end
	if lock and lock.owner ~= owner and lock.expires > now then
		return nil
	end
	return { data = value.data, lock = { owner = owner, expires = now + duration } }
end

function Lease.commit(record: any, owner: string, now: number, duration: number, snapshot: any, release: boolean): any?
	if type(record) ~= "table" or type(record.lock) ~= "table" or record.lock.owner ~= owner
		or type(record.lock.expires) ~= "number" or record.lock.expires <= now then
		return nil
	end
	return {
		data = snapshot,
		lock = if release then nil else { owner = owner, expires = now + duration },
	}
end

return Lease
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[--!strict

export type Piece = { id: number, item: string, x: number, z: number, rotation: number }
export type Data = {
	version: number, coins: number, inventory: { [string]: number },
	builds: { Piece }, nextId: number, kills: number, questClaimed: boolean,
}

local Profile = {}

function Profile.new(): Data
	return {
		version = 1, coins = 200,
		inventory = { Medkit = 2, Crate = 3, Bench = 1, Lamp = 1 },
		builds = {}, nextId = 1, kills = 0, questClaimed = false,
	}
end

function Profile.copy(data: Data): Data
	local copy = table.clone(data)
	copy.inventory = table.clone(data.inventory)
	copy.builds = {}
	for _, piece in data.builds do
		table.insert(copy.builds, table.clone(piece))
	end
	return copy
end

function Profile.decode(raw: any, catalog: any, grid: any): Data?
	if type(raw) ~= "table" or raw.version ~= 1 or type(raw.inventory) ~= "table"
		or type(raw.builds) ~= "table" or type(raw.questClaimed) ~= "boolean" then
		return nil
	end
	if not grid.integer(raw.coins, 0, 1000000000) or not grid.integer(raw.kills, 0, 1000000000)
		or not grid.integer(raw.nextId, 1, 1000000000) then
		return nil
	end
	local data = Profile.new()
	data.coins, data.kills = raw.coins, raw.kills
	data.questClaimed, data.nextId = raw.questClaimed, raw.nextId
	data.inventory = {}
	for id, count in raw.inventory do
		if type(id) ~= "string" or not catalog[id] or not grid.integer(count, 0, catalog[id].limit) then
			return nil
		end
		data.inventory[id] = count
	end
	local seen = {}
	local totals = table.clone(data.inventory)
	local count = 0
	for index, piece in raw.builds do
		count += 1
		if count > 40 or not grid.integer(index, 1, #raw.builds) or type(piece) ~= "table"
			or not grid.integer(piece.id, 1, raw.nextId - 1) or seen[piece.id]
			or type(piece.item) ~= "string" then
			return nil
		end
		local fits = grid.fits(data.builds, catalog, piece.item, piece.x, piece.z, piece.rotation, 8)
		if not fits then
			return nil
		end
		totals[piece.item] = (totals[piece.item] or 0) + 1
		if totals[piece.item] > catalog[piece.item].limit then
			return nil
		end
		seen[piece.id] = true
		table.insert(data.builds, { id = piece.id, item = piece.item, x = piece.x, z = piece.z, rotation = piece.rotation })
	end
	return data
end

return Profile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict

type Bucket = { tokens: number, time: number }
type Limiter = { capacity: number, refill: number, buckets: { [number]: Bucket } }
local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(capacity: number, refill: number)
	return setmetatable({ capacity = capacity, refill = refill, buckets = {} :: { [number]: Bucket } }, RateLimiter)
end

function RateLimiter.allow(self: Limiter, userId: number, now: number): boolean
	local bucket = self.buckets[userId]
	if not bucket then
		bucket = { tokens = self.capacity, time = now }
		self.buckets[userId] = bucket
	end
	bucket.tokens = math.min(self.capacity, bucket.tokens + math.max(0, now - bucket.time) * self.refill)
	bucket.time = math.max(now, bucket.time)
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

function RateLimiter.remove(self: Limiter, userId: number)
	self.buckets[userId] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
      </Item>
