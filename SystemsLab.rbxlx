      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Grid</string>
          <string name="Source"><![CDATA[--!strict

export type Piece = { id: number, item: string, x: number, z: number, rotation: number }
export type Footprint = { width: number, depth: number }

local Grid = {}

function Grid.integer(value: any, minimum: number, maximum: number): boolean
	return type(value) == "number" and value == value and value % 1 == 0
		and value >= minimum and value <= maximum
end

function Grid.dimensions(item: Footprint, rotation: number): (number, number)
	if rotation % 2 == 1 then
		return item.depth, item.width
	end
	return item.width, item.depth
end

function Grid.fits(pieces: { Piece }, catalog: any, itemId: string, x: number, z: number, rotation: number, cells: number): (boolean, string?)
	local item = catalog[itemId]
	if not item or item.kind ~= "furniture" then
		return false, "Choose a furniture item."
	end
	if not Grid.integer(x, 1, cells) or not Grid.integer(z, 1, cells) or not Grid.integer(rotation, 0, 3) then
		return false, "That position is outside the plot."
	end
	local width, depth = Grid.dimensions(item, rotation)
	if x + width - 1 > cells or z + depth - 1 > cells then
		return false, "That item reaches past the edge."
	end
	for _, other in pieces do
		local otherItem = catalog[other.item]
		local otherWidth, otherDepth = Grid.dimensions(otherItem, other.rotation)
		if x < other.x + otherWidth and x + width > other.x
			and z < other.z + otherDepth and z + depth > other.z then
			return false, "That space is occupied."
		end
	end
	return true, nil
end

function Grid.center(x: number, z: number, width: number, depth: number, cells: number, size: number): (number, number)
	return (x - 1 + width / 2 - cells / 2) * size, (z - 1 + depth / 2 - cells / 2) * size
end

return Grid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Settings</string>
          <string name="Source"><![CDATA[--!strict

return table.freeze({
	Author = "kurodakoo",
	Grid = { cells = 8, size = 4, maxPieces = 40, reach = 55 },
	Combat = {
		comboReset = 1.15,
		lightDamage = { 9, 9, 12, 18 },
		lightWindup = 0.13,
		lightRecovery = 0.32,
		finisherRecovery = 0.7,
		heavyDamage = 28,
		heavyWindup = 0.5,
		heavyRecovery = 0.85,
		heavyCooldown = 3,
		parryWindow = 0.24,
		parryRecovery = 0.35,
		parryCooldown = 1.1,
		parryStun = 1.2,
		dashCooldown = 1.5,
		dashDistance = 12,
		dashInvulnerability = 0.18,
		stun = 0.18,
		pvp = false,
	},
	Animations = {
		Light = { 0, 0, 0, 0 },
		Heavy = 0,
		Parry = 0,
		Dash = 0,
	},
})
]]></string>
