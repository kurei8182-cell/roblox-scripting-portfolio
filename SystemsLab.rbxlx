          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[--!strict

return table.freeze({
	Medkit = { name = "Medkit", price = 35, kind = "consumable", heal = 40, limit = 10 },
	Crate = { name = "Cargo crate", price = 20, kind = "furniture", width = 1, depth = 1, height = 3, limit = 30 },
	Bench = { name = "Work bench", price = 60, kind = "furniture", width = 2, depth = 1, height = 3, limit = 10 },
	Lamp = { name = "Signal lamp", price = 45, kind = "furniture", width = 1, depth = 1, height = 7, limit = 10 },
})
]]></string>
